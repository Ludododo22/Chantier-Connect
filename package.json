{
  "name": "chantier-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --watch dist-server/index.js",
    "dev:full": "pnpm build:server && concurrently -k \"vite\" \"node --watch dist-server/index.js\" \"tsc --watch -p tsconfig.server.json --preserveWatchOutput\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:server && vite build",
    "start": "node dist-server/index.js",
    "db:migrate": "pnpm build:server && node dist-server/migrate.js",
    "db:seed": "pnpm build:server && node dist-server/seed.js",
    "check:roles": "node tests-audits/tests/check-roles.mjs",
    "check:tenant-isolation": "node tests-audits/tests/check-tenant-isolation.mjs",
    "check:production-config": "node tests-audits/tests/check-production-config.mjs",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
